# Copy to .env in the project root. Fill the three values below locally.
# .env is ignored by Git. Never paste credentials into chat or commit them.
# Use the API base URL supplied by your provider, often ending in /v1.
# Do not append /chat/completions or /responses to the base URL.
FINQA_JUDGE_API_KEY=
FINQA_JUDGE_BASE_URL=
FINQA_JUDGE_MODEL=

# For an OpenAI-compatible /chat/completions endpoint, keep this value.
# Use responses only if the provider supports the original Responses payload.
FINQA_JUDGE_API_STYLE=chat_completions

# Optional, only for providers/models that support reasoning effort (e.g. low).
# With chat_completions, this also selects max_completion_tokens.
FINQA_JUDGE_REASONING_EFFORT=

# Optional: raise this for reasoning models whose hidden reasoning can consume
# the full completion budget before emitting the required true/false verdict.
FINQA_JUDGE_SINGLE_MAX_OUTPUT_TOKENS=512

# Optional: a different model for multi-table judging; defaults to the model above.
# FINQA_JUDGE_MULTI_TABLE_MODEL=
